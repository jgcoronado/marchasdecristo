#  Análisis estático de PHP (PHPStan). Ver docs/code-quality.md.
#
#  Se ejecuta con el PHAR, sin composer ni vendor/ (igual que el resto del
#  proyecto): `scripts/quality.sh` lo descarga a .tools/ la primera vez.
#
#      scripts/quality.sh phpstan          # análisis completo
#      scripts/quality.sh baseline         # congela el estado actual
#
#  Este fichero es el `.dist`: si necesitas ajustes locales temporales, copia a
#  phpstan.neon (gitignorado) y edita ahí; PHPStan prefiere el sin-dist.

includes:
    - phpstan-baseline.neon

parameters:
    # Nivel vigente. La escalera y el criterio para subir están en
    # docs/code-quality.md §5 — no lo subas sin regenerar el baseline.
    level: 5

    paths:
        - php/app
        - php/public
        - php/tools
        - scripts

    excludePaths:
        analyse:
            # 8.100 líneas de datos generados (padrón de municipios del INE),
            # no código que se revise a mano.
            - php/app/geo/municipios_es.php

    # El autoload del proyecto es el spl_autoload_register de bootstrap.php
    # (ADR-001), no un vendor/autoload.php: hay que decirle a PHPStan dónde
    # viven las clases de App\.
    scanDirectories:
        - php/app/src

    # `APP_DIR` y compañía se definen en tiempo de petición (index.php), no en
    # un fichero que PHPStan pueda cargar.
    dynamicConstantNames:
        - APP_DIR
        - DATA_DIR

    ignoreErrors:
        # Las plantillas reciben sus variables por `extract()` en
        # View::capture(), así que PHPStan nunca las ve declaradas. Ignorar el
        # identificador (y no la ruta entera) mantiene activos todos los demás
        # chequeos dentro de templates/.
        -
            identifier: variable.undefined
            path: php/app/templates

        # Artefacto de inferencia de PHPStan 2.2, verificado el 2026-08-03: en
        # `foreach ($fields as [$key, $label, $type])` sobre un array de tuplas
        # constantes, comparar `$type` estrecha la tupla entera y al fusionar las
        # dos ramas `$key` colapsa a *NEVER*. Al entrar en el bucle `$key` sí es
        # la unión correcta (comprobado con \PHPStan\dumpType), y quitar el
        # ternario de `$type` hace desaparecer el aviso: el código es correcto y
        # los campos de municipio se pintan. Revisar al subir de versión.
        -
            identifier: identical.alwaysFalse
            paths:
                - php/app/templates/admin/banda_form.php
                - php/app/templates/admin/banda_add.php

        # Guard defensivo intencionado: hoy toda provincia de `PROVINCIAS` tiene
        # su entrada en `PROVINCIA_BBOX` y PHPStan lo demuestra, pero el `isset`
        # existe para que añadir una provincia sin bbox devuelva null en vez de
        # reventar.
        -
            identifier: isset.offset
            path: php/app/src/Mapa.php

        # `array_values()` deliberado aunque PHPStan pruebe que hoy sobra: en
        # `json_encode()` garantiza array JSON y no objeto, y en los placeholders
        # de `IN (...)` garantiza claves posicionales. Son las dos cosas que se
        # romperían en silencio si aguas arriba apareciera un hueco.
        -
            identifier: arrayValues.list
            paths:
                - php/app/src/Repo.php
                - php/app/src/AdminRepo.php
                - php/app/src/Admin.php
                - php/app/src/PropuestaRepo.php

        # Variables capturadas por referencia en un closure (`use (&$x)`):
        # PHPStan las evalúa con el valor del momento de la definición y no ve
        # las escrituras posteriores. Falso positivo conocido.
        # BASE_DIR se define en tiempo de petición (index.php, _cli.php, seed_*.php...)
        # antes de requerir config.php con una ruta dinámica (`APP_DIR . '/config.php'`),
        # así que PHPStan no puede seguir ese require y no ve la constante definida.
        # dynamicConstantNames NO evita este aviso (solo afecta el valor inferido de
        # una constante que ya se considera existente, no su existencia) — comprobado
        # con phpstan 2.2.7.
        -
            identifier: constant.notFound
            path: php/app/config.php
        -
            identifier: booleanNot.alwaysTrue
            path: scripts/sync_db_to_prod.php
        -
            identifier: deadCode.unreachable
            path: scripts/sync_db_to_prod.php

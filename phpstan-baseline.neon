# Estado congelado de PHPStan: los errores que YA existían cuando se introdujo
# el gate (2026-08-03, nivel 5). CI está en verde con este fichero, así que el
# código NUEVO tiene que salir limpio desde el primer día.
#
# Esto NO es una lista de cosas ignoradas para siempre: es la lista de trabajo
# del burn-down priorizado de docs/code-quality.md §6. Al resolver un error,
# regenera el fichero con `scripts/quality.sh baseline` y el contador baja.
#
# Los falsos positivos estructurales (extract() en plantillas, closures con
# use (&$x)…) NO viven aquí, sino en `ignoreErrors` de phpstan.neon.dist, con
# su motivo escrito. Si algo de este fichero resulta ser un falso positivo,
# muévelo allí en vez de dejarlo aquí.

parameters:
	ignoreErrors:
		-
			message: '#^Offset ''NOMBRE_BREVE'' on array\{NOMBRE_COMPLETO\: mixed, NOMBRE_BREVE\: mixed, LOCALIDAD\: mixed, PROVINCIA\: mixed, FECHA_FUND\: mixed, FECHA_EXT\: mixed, DIRECTOR_ACTUAL\: mixed, DIR_MUS_ACTUAL\: mixed, \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: php/app/src/Admin.php

		-
			message: '#^Offset ''code'' on array\{code\: string, autorId\?\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: php/app/src/Admin.php


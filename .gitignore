# Environment — never commit real secrets
/.env
/.env.ftp

# Desvío de APP_DIR por host: lo genera el deploy de PRE y solo debe existir
# allí — versionarlo haría que producción cargase el app/ de preproducción.
/php/public/env.php

# Runtime data
/data
/snapshots

# SQLite databases — nunca subir al repo (prod tiene sus propias escrituras)
*.db
*.db-shm
*.db-wal

# Salidas generadas del matcher de streaming y del descubridor de marchas
# (candidatos.ndjson/.csv, informe.md y la caché HTTP: se regeneran)
/tools/music_links/*.csv
/tools/music_links/out/
__pycache__/

# Session logs (auto-generated docs)
/docs/session-*.md

# Legacy deployment artifacts (kept local only)
.vercel

# IDE / tools
.claude
.vscode

# Artefactos del montaje FUSE (ficheros borrados con el descriptor abierto)
.fuse_hidden*
